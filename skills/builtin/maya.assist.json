{
  "id": "maya.assist",
  "version": "0.11.0",
  "name": "Maya / 3D",
  "description": "Preparar script Maya Python ou MEL em arquivo para revisão humana antes de execução no Maya.",
  "permissions": [
    "filesystem.write"
  ],
  "inputs": {
