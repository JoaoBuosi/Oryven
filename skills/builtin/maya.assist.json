    "script gravado com aviso de revisão manual"
  ],
  "family": "maya",
  "executable": true,
  "risk": "medium",
  "stage": "mvp",
  "outputs": {
    "script_file": "script preparado"
  },
  "tools": [
    "maya",
    "python",
    "filesystem"
  ]
