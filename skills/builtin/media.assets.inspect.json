{
  "id": "media.assets.inspect",
  "version": "1.0.0",
  "name": "Media Asset Inspector",
  "description": "Inventaria mídia e metadados básicos.",
  "permissions": [
    "workspace.read"
  ],
  "inputs": {
    "workspace": "path",
    "path": "folder"
  },
  "outputs": {
    "inventory": "json"
  },
  "tools": [
    "media",
    "audiovisual"
  ],
  "tests": [
    "unit",
    "approval"
  ],
  "logs": [
    "action",
    "result_metadata"
  ],
  "errors": [
    "validation",
    "io"
  ],
  "success_criteria": [
    "resultado estruturado",
    "execução somente após aprovação"
  ],
  "family": "media",
  "executable": true,
  "risk": "low",
  "stage": "mvp"
}