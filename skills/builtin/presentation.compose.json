{
  "id": "presentation.compose",
  "version": "0.11.0",
  "name": "Apresentações",
  "description": "Criar outline estruturado de apresentação em Markdown para futura renderização em Office/Slides.",
  "permissions": [
    "filesystem.write"
  ],
  "inputs": {
