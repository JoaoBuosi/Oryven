{
  "id": "logistics.analyze",
  "version": "1.0.0",
  "name": "Logistics Analyzer",
  "description": "Analisa CSV logístico e indicadores básicos.",
  "permissions": [
    "workspace.read"
  ],
  "inputs": {
    "workspace": "path",
    "path": "csv"
  },
  "outputs": {
    "analysis": "json"
  },
  "tools": [
    "logistics",
    "analytics"
  ],
  "tests": [
    "unit",
    "approval"
  ],
  "logs": [
    "action",
    "result_metadata"
  ],
  "errors": [
    "validation",
    "io"
  ],
  "success_criteria": [
    "resultado estruturado",
    "execução somente após aprovação"
  ],
  "family": "logistics",
  "executable": true,
  "risk": "low",
  "stage": "mvp"
}