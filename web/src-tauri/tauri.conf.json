{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oryven by Buno AI",
  "version": "0.19.1",
  "identifier": "ai.buno.oryven",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Oryven • Buno AI",
        "width": 1260,
        "height": 860,
        "minWidth": 820,
        "minHeight": 650,
        "backgroundColor": "#0a0d17",
        "label": "main",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend-dist/oryven-backend.exe": "oryven-backend.exe"
    },
    "publisher": "Buno AI",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}